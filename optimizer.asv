clc; clear; close all;

%% Load experimental data
data = readtable('R20_combined_filtered.csv');

% Column meanings
IA = data{:,3};            % Inclination angle (held constant at 0)
FZRaw = data{:,4};        % Normal force
alpha = data{:,5};         % Slip angle (deg)
FYExperimental = data{:,7};        % Experimental lateral force
source = data{:,9};        % Source file name

%% Define bins and corresponding nominal FZ values
bins = [50, 100, 150, 200, 250];
FYAll = [];
FZAll = [];
alpha_all = [];
IAAll = [];

% Assign data points to nominal FZ bins
for i = 1:numel(bins)
    tag = sprintf('R20_FZ_%d_filtered', bins(i));
    idx = contains(source, tag);
    FYAll = [FYAll; FYExperimental(idx)];
    FZAll = [FZAll; bins(i) * ones(sum(idx),1)];
    alpha_all = [alpha_all; alpha(idx)];
    IAAll = [IAAll; IA(idx)];
end

%% Convert slip angle to radians
alpha_all = deg2rad(alpha_all);

%% Initial parameter guesses
P0 = [250, 1.4, 2.4, -0.25, 3, -0.1, -1.5, 0, 0, -30.5, ...
      1.15, 1, 0, 0, -0.128, 0, 0, 0, 1.43];
L = ones(1,8);

%% Define objective function (returns residuals)
objFun = @(P) FYExperimental_all(P, L, FZAll, IAAll, alpha_all, FYAll);

%% Optimization settings
options = optimoptions('lsqnonlin', 'Display', 'iter', ...
    'MaxFunctionEvaluations', 20000, 'TolFun', 1e-8, 'TolX', 1e-8);

lb = -Inf(1,19);
ub = Inf(1,19);

%% Fit parameters
P_opt = lsqnonlin(objFun, P0, lb, ub, options);
disp('Optimized Parameters:')
disp(P_opt)

%% Compute predicted FY and RMSE
FY_pred = pacejka(P_opt, L, FZAll, IAAll, alpha_all);
rmse = sqrt(mean((FYAll - FY_pred).^2));
fprintf('Overall RMSE: %.3f\n', rmse);

%% ====== PLOTTING SECTION ======

% Ask user which bin(s) to plot
disp('Available bins: [50, 100, 150, 200, 250]');
plot_choice = input('Enter FZ bin to plot (or "all" for all bins): ', 's');

figure; hold on; grid on;
colors = lines(numel(bins));

if strcmpi(plot_choice, 'all')
    % Plot all bins together
    for i = 1:numel(bins)
        idx = FZAll == bins(i);
        scatter(rad2deg(alpha_all(idx)), FYAll(idx), 10, colors(i,:), 'filled', ...
            'DisplayName', sprintf('Exp FZ=%d', bins(i)));

        [a_sort, ord] = sort(alpha_all(idx));
        fy_fit = pacejka(P_opt, L, FZAll(idx), IAAll(idx), a_sort);
        plot(rad2deg(a_sort), fy_fit, 'Color', colors(i,:), 'LineWidth', 1.5, ...
            'DisplayName', sprintf('Fit FZ=%d', bins(i)));
    end
    title(sprintf('Pacejka Fit (All Bins) - RMSE = %.2f', rmse));

else
    % Plot only the selected bin
    bin_val = str2double(plot_choice);
    if isnan(bin_val) || ~ismember(bin_val, bins)
        error('Invalid bin selection. Must be one of: %s', num2str(bins));
    end

    idx = FZAll == bin_val;
    scatter(rad2deg(alpha_all(idx)), FYAll(idx), 5, 'filled', ...
        'DisplayName', sprintf('Exp FZ=%d', bin_val), 'MarkerFaceColor', [0.3 0.3 0.9]);

    [a_sort, ord] = sort(alpha_all(idx));
    fy_fit = pacejka(P_opt, L, FZAll(idx), IAAll(idx), a_sort);
    plot(rad2deg(a_sort), fy_fit, 'r', 'LineWidth', 2, ...
        'DisplayName', sprintf('Fit FZ=%d', bin_val));
    
    title(sprintf('Pacejka Fit (FZ = %d N) - RMSE = %.2f', bin_val, rmse));
end

xlabel('Slip Angle [deg]');
ylabel('Lateral Force FY [N]');
legend('Location', 'best');

function err = FYExperimental_all(P, L, FZ, IA, alpha, FYExperimental)
    FY_model = pacejka(P, L, FZ, IA, alpha);
    err = FY_model - FYExperimental;   % residuals for lsqnonlin
end
